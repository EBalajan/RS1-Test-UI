<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trailblazer_gui</name>
  <version>0.1.0</version>
  <description>
    Operator GUI for the TrailBlazer trail-inspection rover. Phase 1 provides
    W/A/S/D teleop mapping with trail-node recording; Phase 2 visualises the
    autonomous inspection run, colouring routes green when clear and red when
    blocked by an obstacle.
  </description>
  <maintainer email="you@example.com">TrailBlazer Team</maintainer>
  <license>TODO: Declare license</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>python3-tk</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
